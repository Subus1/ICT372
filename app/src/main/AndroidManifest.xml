<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ICT372">

        <!-- Authentication (Task 1) -->
        <activity
            android:name=".RegAct"
            android:exported="false" />
        <activity
            android:name=".LoginAct"
            android:exported="true" />

        <!-- Task 2: User Experience (YOUR TASK) -->
        <activity
            android:name=".HomeAct"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SearchAct"
            android:exported="false" />

        <!-- Task 3: Shop / Transaction -->
        <activity
            android:name=".CartAct"
            android:exported="false" />
        <activity
            android:name=".CheckoutAct"
            android:exported="false" />

        <!-- Task 4: Product Details / History -->
        <activity
            android:name=".ProductDetailsAct"
            android:exported="false" />
        <activity
            android:name=".OrdHistoryAct"
            android:exported="false" />

        <!-- MainActivity (optional) -->
        <activity
            android:name=".MainActivity"
            android:exported="false">
        </activity>

    </application>

</manifest>
